# AutoInvoice Configuration

PROJECT_NAME="AutoInvoice"
STACK_NAME=autoinvoice
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"

# Security - CHANGE THESE IN PRODUCTION
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Database (for local development)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Database URL (Railway provides this automatically)
# DATABASE_URL=postgresql://user:password@host:port/database

# Frontend
FRONTEND_HOST=http://localhost:5173

# Brevo (system emails: password reset, new account, test email)
BREVO_API_KEY=
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=AutoInvoice

# Google OAuth (lets users send invoices from their own Gmail account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback

# Environment
DOMAIN=localhost
ENVIRONMENT=local
# AutoInvoice Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control!

# Basic Setup
PROJECT_NAME=AutoInvoice
ENVIRONMENT=local

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# First admin user
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=your-secure-password-here

# Database - Two Options (use one)
# Option 1: Full URL (recommended for production/Railway)
DATABASE_URL=
# Option 2: Individual variables (for local dev)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password

# URLs
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173
DOMAIN=localhost

# Brevo (system emails: password reset, new account, test email) - get a free API key at brevo.com
BREVO_API_KEY=
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=AutoInvoice

# Google OAuth (lets users send invoices from their own Gmail account)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback

# Server
PORT=8000

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48

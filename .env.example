# AutoInvoice Configuration Template
# Copy this file to .env and fill in your values

PROJECT_NAME="AutoInvoice"
STACK_NAME=autoinvoice
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173"

# Security - CHANGE THESE IN PRODUCTION
# Generate a secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=your-secure-password-here

# Database (for local development)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password

# Database URL (Railway provides this automatically)
# DATABASE_URL=postgresql://user:password@host:port/database

# Frontend URL
FRONTEND_HOST=http://localhost:5173

# Email Configuration (for password reset)
SMTP_HOST=smtp.example.com
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAILS_FROM_EMAIL=noreply@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Environment
DOMAIN=localhost
ENVIRONMENT=local
# AutoInvoice Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control!

# Basic Setup
PROJECT_NAME=AutoInvoice
ENVIRONMENT=local

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# First admin user
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=your-secure-password-here

# Database - Two Options (use one)
# Option 1: Full URL (recommended for production/Railway)
DATABASE_URL=
# Option 2: Individual variables (for local dev)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password

# URLs
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173
DOMAIN=localhost

# Email (SMTP) - Optional for local dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_SSL=False
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=AutoInvoice

# Server
PORT=8000

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48

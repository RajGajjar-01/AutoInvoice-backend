# AutoInvoice - Production Configuration

# Required - Production Settings
ENVIRONMENT=production
PROJECT_NAME=AutoInvoice

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=<generate-a-secure-random-key>

FIRST_SUPERUSER=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=<secure-admin-password>

# Database - Railway provides DATABASE_URL automatically
# Or set individual variables:
# POSTGRES_SERVER=your-db-host.aws.com
# POSTGRES_PORT=5432
# POSTGRES_DB=autoinvoice
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=<secure-db-password>

# URLs - CRITICAL
FRONTEND_HOST=https://your-domain.com
DOMAIN=your-domain.com
BACKEND_CORS_ORIGINS=https://your-domain.com

# Brevo - Required for production (system emails: password reset, new account, test email)
BREVO_API_KEY=<brevo-api-key>
EMAILS_FROM_EMAIL=noreply@your-domain.com
EMAILS_FROM_NAME=AutoInvoice

# Google OAuth - Required for production (lets users send invoices from their own Gmail account)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/google/callback

# Server
PORT=8000

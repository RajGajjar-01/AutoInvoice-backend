# AutoInvoice - Production Configuration

# Required - Production Settings
ENVIRONMENT=production
PROJECT_NAME=AutoInvoice

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=<generate-a-secure-random-key>

FIRST_SUPERUSER=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=<secure-admin-password>

# Database - Railway provides DATABASE_URL automatically
# Or set individual variables:
# POSTGRES_SERVER=your-db-host.aws.com
# POSTGRES_PORT=5432
# POSTGRES_DB=autoinvoice
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=<secure-db-password>

# URLs - CRITICAL
FRONTEND_HOST=https://your-domain.com
DOMAIN=your-domain.com
BACKEND_CORS_ORIGINS=https://your-domain.com

# Email (SMTP) - Required for production
# Use SendGrid, AWS SES, or any SMTP provider
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=<sendgrid-api-key>
SMTP_TLS=True
SMTP_SSL=False
EMAILS_FROM_EMAIL=noreply@your-domain.com
EMAILS_FROM_NAME=AutoInvoice

# Server
PORT=8000
